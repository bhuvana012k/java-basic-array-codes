public class Main {
    public static void main(String[] args) {
      int[] arr={10, 20, 30, 40};
      float avg=0;
      int total=0;
      int length=arr.length;
      for(int i=0;i<arr.length;i++){
        total+=arr[i];
      }
      avg=(float)total/length;

      System.out.println("Average:"+avg);
    }
}
